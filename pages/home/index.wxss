/* 主页样式 —— 完全照搬参考稿：
   白底、橙色品牌行、特大左对齐标语、橄榄绿圆 + 斜放暗卡、浅绿面板、双按钮。
   本页的橙是参考稿的珊瑚橙（独立于 journey 的主题绿），只在这页用 */

page {
  /* 参考稿取色 */
  --o-strong: #f4622a;  /* 品牌块 / 主按钮 */
  --o-line: #f2703d;    /* 陷阱框 / 强调数字 */
  --o-soft: #f8926a;    /* 角标底 */
  --o-ink: #7c2d12;     /* 角标文字 */
  --o-olive: #7b8449;   /* 衬底圆 */
  --o-panel: #e6f0da;   /* 说明面板 */
}

.page {
  padding: 0 0 var(--sp-4);
}

/* 品牌行：橙色圆角小方块 + 名字，左对齐 */
.brand {
  display: flex;
  align-items: center;
  padding: var(--sp-4) 40rpx 0;
}

.brand__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--o-strong);
}

.brand__emoji {
  font-size: 32rpx;
  line-height: 1;
}

.brand__name {
  margin-left: var(--sp-2);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

/* 特大号标语：全页最大的字，左对齐、紧字距 —— 参考稿的视觉锚点 */
.hero {
  padding: var(--sp-4) 40rpx 0;
}

.hero__line {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #161616;
  letter-spacing: 2rpx;
}

/* 标本卡：橄榄绿圆衬底 + 微斜的暗卡。
   圆是绝对定位的背景，卡片 transform 斜放 —— 像一张被拍在桌面上的截图 */
.specimen {
  position: relative;
  height: 460rpx;
  margin-top: var(--sp-4);
}

.specimen__circle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 400rpx;
  height: 400rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: var(--o-olive);
  opacity: 0.55;
}

.specimen__card {
  position: absolute;
  left: 50%;
  top: 50%;
  box-sizing: border-box;
  width: 560rpx;
  padding: var(--sp-4);
  transform: translate(-50%, -50%) rotate(-4deg);
  border-radius: 24rpx;
  background: #2b2a24;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
}

.specimen__head {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-4);
}

/* 商品图占位：更暗的小方块 + emoji */
.specimen__glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #1c1b17;
}

.specimen__emoji {
  font-size: 44rpx;
  line-height: 1;
}

.specimen__meta {
  margin-left: var(--sp-3);
}

.specimen__goods {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.specimen__price {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.specimen__now {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 划掉的原价：比现价小、灰、中划线 —— 电商卡的通用语言 */
.specimen__was {
  margin-left: var(--sp-2);
  font-size: 26rpx;
  color: #8d8a80;
  text-decoration: line-through;
}

/* 陷阱标注：实线橙框压在促销行上，角标挂在卡右缘外（参考稿的位置） */
.trap {
  position: relative;
  border: 3rpx solid var(--o-line);
  border-radius: 10rpx;
  background: rgba(242, 112, 61, 0.12);
}

.trap + .trap {
  margin-top: var(--sp-4);
}

.trap__tag {
  position: absolute;
  top: -16rpx;
  right: -20rpx;
  padding: 4rpx var(--sp-2);
  border-radius: 8rpx;
  background: var(--o-soft);
  color: var(--o-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.trap__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-3);
}

.trap__left {
  font-size: 28rpx;
  font-weight: 500;
  color: #f2efe6;
}

.trap__right {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--o-line);
  letter-spacing: 2rpx;
}

/* 浅绿说明面板：一句加粗反问 + 灰色白话 */
.note {
  margin: var(--sp-2) 40rpx 0;
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--o-panel);
}

.note__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

/* 入口：橙色主按钮在上，描边按钮在下。
   宽度强制与上方面板一致（小程序 button 有默认宽度，必须显式撑满） */
.entry {
  margin: var(--sp-4) 40rpx 0;
  display: flex;
  flex-direction: column;
}

/* 主按钮「看看例子」：产品的主要功能，橙色大字、全按钮里最重的一档 */
.entry__primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  padding: 0;
  background: var(--o-strong);
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  border-radius: var(--r-md);
}

/* 次按钮「上传截图」：白底描边 */
.entry__secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 0;
  margin-top: 24rpx;
  background: #ffffff;
  color: var(--c-text);
  font-size: 32rpx;
  font-weight: 500;
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-md);
}

/* 署名：字号跟上按钮一档，和入口一起把底部填满 */
.credit {
  margin: 64rpx 0 32rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--c-text-3);
  opacity: 0.9;
}