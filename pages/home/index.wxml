<!-- 主页：完全照搬参考稿的形式 ——
     顶部品牌行 + 特大号左对齐标语 + 斜放的暗色标本卡（橄榄绿圆衬底）+
     浅绿说明面板 + 橙色主按钮/描边副按钮。
     产品名来自 brand.js（页面里不写字面量）。 -->
<view class="page">

  <!-- 品牌行：橙色圆角小方块 + 名字 -->
  <view class="brand">
    <view class="brand__icon">
      <text class="brand__emoji">✋</text>
    </view>
    <text class="brand__name">{{appName}}</text>
  </view>

  <!-- 特大号标语：两行，左对齐，是全页最大的字 -->
  <view class="hero">
    <text class="hero__line">先看清，</text>
    <text class="hero__line">再下单。</text>
  </view>

  <!-- 标本卡：橄榄绿圆衬底，卡片微微斜放，角标挂在卡右缘外 -->
  <view class="specimen">
    <view class="specimen__circle"></view>
    <view class="specimen__card">
      <view class="specimen__head">
        <view class="specimen__glyph">
          <text class="specimen__emoji">🎧</text>
        </view>
        <view class="specimen__meta">
          <text class="specimen__goods">无线降噪耳机</text>
          <view class="specimen__price">
            <text class="specimen__now">¥ 299</text>
            <text class="specimen__was">¥ 399</text>
          </view>
        </view>
      </view>
      <view class="trap">
        <view class="trap__row">
          <text class="trap__left">再买 ¥ 101</text>
          <text class="trap__right">立减 ¥ 50</text>
        </view>
        <view class="trap__tag">凑单诱导</view>
      </view>
      <view class="trap">
        <view class="trap__row">
          <text class="trap__left">优惠即将结束</text>
          <text class="trap__right">00 : 14 : 59</text>
        </view>
        <view class="trap__tag">制造紧迫感</view>
      </view>
    </view>
  </view>

  <!-- 浅绿说明面板：只留加粗反问一句 -->
  <view class="note">
    <text class="note__title">为了省 ¥ 50，多花 ¥ 101？</text>
  </view>

  <!-- 入口：橙色主按钮「上传截图」直达 journey 第四屏；描边按钮「看看例子」从头走示例。
       宽度与面板对齐 -->
  <!-- 入口：主按钮「看看例子」是产品的主要功能，橙色大字；
       「上传截图」直达第四屏，描边次按钮。宽度与面板对齐 -->
  <view class="entry">
    <button class="entry__primary" bindtap="onStartExamples">看看例子</button>
    <button class="entry__secondary" bindtap="onUploadTap">上传截图</button>
  </view>

  <!-- 署名 -->
  <text class="credit">— created by Frank —</text>

</view>