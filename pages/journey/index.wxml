<view class="page">

  <!-- 第四屏还没选图：选图区替代舞台。三段示例永远走不到这里。
       排版按定稿：大标题 → 三张可选示例卡 → 虚线上传行 → 开始分析大按钮 -->
  <view class="own-pick" wx:if="{{isOwn && ownState === 'pick'}}">
    <text class="own-pick__title">选择截图</text>

    <!-- 三张示例卡：点一下只是选中（橙框 + 对勾），链路由「开始分析」启动。
         catchtap 别让点击冒泡（这一块没有整块点击，只防将来） -->
    <view class="own-pick__samples">
      <view
        wx:for="{{sampleImages}}"
        wx:key="*this"
        class="own-pick__sample {{ownSampleIndex === index ? 'own-pick__sample--on' : ''}}"
        data-index="{{index}}"
        catchtap="onPickSample"
      >
        <view class="own-pick__shotbox">
          <image class="own-pick__shot" src="{{item}}" mode="aspectFill" />
          <view class="own-pick__radio {{ownSampleIndex === index ? 'own-pick__radio--on' : ''}}">
            <text wx:if="{{ownSampleIndex === index}}" class="own-pick__tick">✓</text>
          </view>
        </view>
        <text class="own-pick__label {{ownSampleIndex === index ? 'own-pick__label--on' : ''}}">{{sampleLabels[index]}}</text>
      </view>
    </view>

    <!-- 上传自己的图：虚线框一行。选完立刻走读图链路，不用再点开始分析 -->
    <view class="own-pick__upload" catchtap="onPickImage">
      <text class="own-pick__upload-text">上传截图</text>
      <text class="own-pick__upload-arrow">›</text>
    </view>

    <!-- 开始分析：选中一张示例图才走链路；没选时点一下只弹提示 -->
    <view class="own-pick__go" catchtap="onStartAnalyze">
      <text class="own-pick__go-text">开始分析 ›</text>
    </view>
  </view>

  <!-- 图上左右滑动翻页：判别在 utils/swipe.js。touchcancel（来电等打断）当作没滑。
       第四屏选图态不渲染舞台（这里用取反条件而不是 wx:else，中间隔着注释也不怕断链） -->
  <view
    class="stage"
    wx:if="{{!(isOwn && ownState === 'pick')}}"
    bindtap="onStageTap"
    bindtouchstart="onStageTouchStart"
    bindtouchend="onStageTouchEnd"
    bindtouchcancel="onStageTouchCancel"
  >
    <image class="stage__img" src="{{shot.image}}" mode="widthFix" lazy-load="{{false}}" />

    <block wx:for="{{hooks}}" wx:key="id">
      <!-- 按住时：把已经标出来的那几处盖掉，商品和价格留下。
           盖子是实心的（用页面底色），因为它要替你说「这里本来有东西」。 -->
      <view
        wx:if="{{item.covered}}"
        class="cover"
        style="{{item.style}}"
        catchtap="onCoverTap"
      ></view>
      <!-- 还没找到的：只留一块透明热区。看得见就没有「找」的意义了 -->
      <view
        wx:elif="{{item.hidden}}"
        class="hit"
        style="{{item.style}}"
        data-id="{{item.id}}"
        catchtap="onHitTap"
      ></view>
      <!-- 教学屏还没点到的：同样是一块透明热区。
           入口在图上，不在卡片上 —— 先点中，卡片才上线 -->
      <view
        wx:elif="{{!item.revealed}}"
        class="hit"
        style="{{item.style}}"
        data-id="{{item.id}}"
        catchtap="onHitTap"
      ></view>
      <!-- 已经标出来的：带编号的框（编号 = 找到的先后，第一个点中的是 ①），
           点它把对应卡片切过来 -->
      <view
        wx:elif="{{item.revealed}}"
        class="mark"
        style="{{item.style}}"
        data-id="{{item.id}}"
        catchtap="onMarkTap"
      >
        <text class="mark__no">{{item.order}}</text>
      </view>
    </block>

    <!-- 左右翻页箭头：贴屏幕两侧边缘、图的垂直中点。
         stage 只有 82% 宽，两侧各约 9% 空白 —— 箭头就住在那里，不压图不挡热区。
         首末两张时置灰；点了没反应由 onPrevShot / onNextShot 的边界守卫兜住。 -->
    <view
      class="stage-nav stage-nav--prev {{isFirstShot ? 'stage-nav--off' : ''}}"
      catchtap="onPrevShot"
    >
      <text class="stage-nav__arrow">‹</text>
    </view>
    <view
      class="stage-nav stage-nav--next {{isLastShot ? 'stage-nav--off' : ''}}"
      catchtap="onNextShot"
    >
      <text class="stage-nav__arrow">›</text>
    </view>
  </view>

  <!-- 引导条：第一次打开的人唯一的说明书。
       位置在图片正下方、按住按钮上方 —— 操作区的第一眼，但不在页面最顶
       （顶部方案试过，被否）。加粗 + 呼吸动画，让它自己往外跳，不靠用户找。 -->
  <view class="guide {{allDone ? 'guide--done' : ''}}" wx:if="{{guide}}">
    <view class="guide__dot"></view>
    <text class="guide__text">{{guide}}</text>
    <text class="guide__action" wx:if="{{skipLabel}}" bindtap="onRevealNext">{{skipLabel}}</text>
  </view>

  <!-- 第四屏失败态：一句真话 + 两个出口。它站在引导条的位置说话，
       引导条此时是空的 —— 两处同时开口会互相抢 -->
  <view class="own-failed" wx:if="{{isOwn && ownNotice}}">
    <text class="own-failed__title">{{ownNotice.title}}</text>
    <text class="own-failed__hint" wx:if="{{ownNotice.hint}}">{{ownNotice.hint}}</text>
    <view class="own-failed__actions">
      <view
        class="own-failed__btn"
        wx:for="{{ownNotice.actions}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onOwnAction"
      >
        <text class="own-failed__btn-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view
    class="hold {{holdReady ? '' : 'hold--off'}} {{holding ? 'hold--on' : ''}}"
    bindtouchstart="onHoldStart"
    bindtouchend="onHoldEnd"
    bindtouchcancel="onHoldEnd"
  >
    <text class="hold__label">{{holdBtnLabel}}</text>
  </view>

  <!-- 这行小字高度常驻（按住时为空也不塌），免得按住的瞬间整页往下跳 -->
  <view class="hold__hint">
    <text class="hold__hint-text">{{holdHint}}</text>
  </view>

  <swiper
    class="cards"
    current="{{cardIndex}}"
    bindchange="onCardChange"
    indicator-dots="{{false}}"
    duration="{{200}}"
  >
    <swiper-item wx:for="{{hooks}}" wx:key="id">
      <view
        class="card {{item.revealed ? 'card--on' : 'card--ghost'}}"
        data-id="{{item.id}}"
        bindtap="onCardTap"
      >
        <!-- 卡片是「点中之后的结果」：没点中只留空壳占位，点了才上线 -->
        <view class="card__inner" wx:if="{{item.revealed}}">
          <view class="card__head">
            <text class="card__name">{{item.hidden ? '第 ' + item.order + ' 处' : item.name}}</text>
            <text class="card__state">{{item.state}}</text>
          </view>
          <text class="card__note">{{item.note}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="foot">
    <view class="foot__row">
      <text class="foot__progress">已标出 {{hookProgress}}</text>
      <!-- 翻页入口已移到图两侧的箭头；最后一屏时在这里给一句收尾（第四屏不算示例） -->
      <text wx:if="{{isLastShot && !isOwn}}" class="foot__progress">三段示例已看完</text>
    </view>
    <!-- 这一行常驻（还没标出时只是灰的），免得卡片入口忽然冒出来把页面顶一下。
         第四屏整行先不渲染：卡片要跨页带图，7.4c 再接，不开一个「能点但打不开」的门 -->
    <view wx:if="{{!isOwn}}" class="foot__row foot__make {{canMakeCard ? '' : 'foot__make--off'}}" bindtap="onMakeCard">
      <text class="foot__make-text">{{canMakeCard ? '生成一张卡片 ›' : '标出一处后可以做成卡片'}}</text>
    </view>
    <!-- 第三屏收尾的转折点：评委在这里变成参与者。三处都标完才出现 -->
    <view class="own-entry" wx:if="{{showOwnEntry}}" bindtap="onEnterOwn">
      <text class="own-entry__text">用你自己的图试一次 ›</text>
    </view>
  </view>

</view>
