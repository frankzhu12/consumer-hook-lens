.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: var(--sp-3);
  box-sizing: border-box;
}

/* 截图 + 标注层
   注意：.stage 的高度由图片撑出来（宽度固定、mode=widthFix），
   所以子元素用百分比定位就能严丝合缝地贴在图上 —— 这是归一化坐标能生效的地方。 */
.stage {
  position: relative;
  width: 82%;
  margin: var(--sp-1) auto 0;
}

.stage__img {
  display: block;
  width: 100%;
  border-radius: var(--r-md);
}

.mark {
  position: absolute;
  box-sizing: border-box;
  border: 3rpx solid var(--c-mark);
  border-radius: 10rpx;
  background: rgba(232, 163, 61, 0.16);
}
/* 这里**不要**写 transition。按住时 .mark 是被 .cover 整个替换掉的
   （wx:if / wx:elif 换的是节点），节点都不存在了，CSS 过渡不会跑。
   写了只会让人以为有淡出效果。瞬间消失反而更准：手指按下去的那一刻，它就没了。 */

/* 还没找到的那几处：热区是透明的，只有点上去才知道自己找没找到 */
.hit {
  position: absolute;
  box-sizing: border-box;
}

/* 左右翻页箭头：贴屏幕两侧边缘、图的垂直中点。
   stage 宽 82%，两侧边距各约 67rpx（750 设计稿）——
   60rpx 的圆钮刚好住进去，离屏幕边 1rpx、离图 6rpx，不压图、不挡热区。
   半透明深底白箭头：压在哪种截图上都读得出来。 */
.stage-nav {
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  margin-top: -30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.45);
}

.stage-nav--prev {
  left: -66rpx;
}

.stage-nav--next {
  right: -66rpx;
}

/* 首末两张时置灰但常驻 —— 忽然冒出来会把整层顶一下 */
.stage-nav--off {
  opacity: 0.25;
}

.stage-nav__arrow {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1;
}

/* 按住时盖住已标出的那几处。
   用实心底色而不是「变灰」：它要替你说出「这里本来有东西」，
   虚线边是为了让「被拿掉了」这件事看得见。 */
.cover {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx dashed rgba(0, 0, 0, 0.14);
  border-radius: 10rpx;
  background: var(--c-bg);
}

/* 编号圆片：挂在标注框左上角，编号 = 找到的先后 */
.mark__no {
  position: absolute;
  top: -18rpx;
  left: -18rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--c-mark);
  color: #ffffff;
  font-size: 22rpx;
}

/* 按住，只看商品。
   这是全场唯一有身体参与感的动作：全宽、大目标、绿色（这套演示的主动色），
   按下的一刻就变色，手指不用等界面的反馈。纯色不加投影 —— 面积已经够醒目 */
.hold {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: var(--sp-3) var(--sp-4) 0;
  border-radius: var(--r-lg);
  background: var(--c-accent);
}

.hold--on {
  background: #17804a;
}

.hold--off {
  background: rgba(0, 0, 0, 0.06);
}

.hold__label {
  font-size: 30rpx;
  color: #ffffff;
}

.hold--off .hold__label {
  color: var(--c-text-3);
}

/* 高度常驻：按住时这行是空的，但不能塌 —— 塌了整页会在按住的瞬间往下跳 */
.hold__hint {
  min-height: 40rpx;
  padding: 0 var(--sp-4);
  text-align: center;
}

.hold__hint-text {
  font-size: 25rpx;
  font-weight: 500;
  color: var(--c-text-2);
}

/* 引导条：第一次打开的人唯一的说明书。
   位置在图片正下方、按住按钮上方 —— 它指引的动作（点卡片、按按钮）都在它下面，
   视线先到它、再落到动作上。底色带呼吸动画：不是一直闪，是 2.4 秒一个来回的
   轻微明暗，余光也能捕捉到「这里有个活着的东西」。找齐了换成绿的，和「按住」呼应。 */
.guide {
  display: flex;
  align-items: center;
  margin: var(--sp-3) var(--sp-4) 0;
  padding: var(--sp-3) var(--sp-4);
  border-radius: var(--r-md);
  background: rgba(232, 163, 61, 0.18);
  border: 1rpx solid rgba(232, 163, 61, 0.55);
  animation: guide-breathe 2.4s ease-in-out infinite;
}

/* 呼吸：只动背景的明暗，不动布局 —— 顶动页面比不显眼更糟 */
@keyframes guide-breathe {
  0%, 100% { background: rgba(232, 163, 61, 0.14); }
  50% { background: rgba(232, 163, 61, 0.32); }
}

/* 找齐后的绿色版呼吸，和「按住」按钮的颜色同族 */
.guide--done {
  background: rgba(23, 128, 74, 0.12);
  border-color: rgba(23, 128, 74, 0.45);
  animation-name: guide-breathe-done;
}

@keyframes guide-breathe-done {
  0%, 100% { background: rgba(23, 128, 74, 0.1); }
  50% { background: rgba(23, 128, 74, 0.26); }
}

/* 左侧脉冲圆点：给「先看我」一个具体的落点，比整条闪更克制 */
.guide__dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin-right: var(--sp-2);
  border-radius: 50%;
  background: var(--c-mark);
  animation: dot-pulse 1.2s ease-in-out infinite;
}

.guide--done .guide__dot {
  background: var(--c-accent);
}

@keyframes dot-pulse {
  0%, 100% { opacity: 0.35; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

/* 加大到 30rpx、字重 700：这是全页唯一「必须被读到」的字，值得比正文重两档。
   色值用 --c-text —— 这里原本写的是 var(--c-text-1)，而 app.wxss 里根本没有这个变量：
   颜色一直是"继承"来的，凑巧继承到深色，所以没人发现。一旦有人改了 page 的文字色，
   引导条就会阴差阳错地跟着变，而改的人不会想到根因在这一行。 */
.guide__text {
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 700;
  color: var(--c-text);
}

.guide__action {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-accent);
  padding-left: var(--sp-3);
  flex-shrink: 0;
}

/* 底部卡片：左右滑动切换。swiper 必须有固定高度 */
.cards {
  height: 210rpx;
  margin: var(--sp-3) var(--sp-4) 0;
}

.card {
  box-sizing: border-box;
  height: 100%;
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
}

.card--on {
  border-color: var(--c-mark);
}

/* 还没点中的卡片：只是个虚线空壳。它不参与交互 ——
   入口在图上，先点中，卡片才上线。空壳占住高度，上线时页面不跳 */
.card--ghost {
  border-style: dashed;
  background: rgba(255, 255, 255, 0.5);
}

/* 上线的一瞬：内容轻轻浮上来，眼睛顺着动效落到卡片上 */
.card__inner {
  animation: card-in 0.25s ease-out;
}

@keyframes card-in {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.card__name {
  font-size: 34rpx;
  font-weight: 700;
}

.card__state {
  font-size: 22rpx;
  color: var(--c-text-3);
}

.card__note {
  display: block;
  margin-top: var(--sp-2);
  font-size: 28rpx;
  line-height: 1.55;
  /* 机制句是这屏真正要留下的东西，用它自己的名字色（和 mark 呼应）而不是灰 */
  color: var(--c-text);
}

/* 底部：内层进度 + 下一张 + 卡片入口 */
.foot {
  padding: var(--sp-2) var(--sp-4) 0;
}

.foot__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot__progress {
  font-size: 24rpx;
  color: var(--c-text-3);
}

/* 卡片入口。它是这一屏的落点，所以给一条淡边界，让它看起来像"可以按" */
.foot__make {
  justify-content: center;
  height: 64rpx;
  margin-top: var(--sp-2);
  border: 1rpx solid var(--c-accent);
  border-radius: var(--r-md);
}

.foot__make-text {
  font-size: 26rpx;
  color: var(--c-accent);
}

/* 还没标出任何一处时：灰掉，但高度不变 */
.foot__make--off {
  border-color: var(--c-line);
}

.foot__make--off .foot__make-text {
  color: var(--c-text-3);
}

/* ── 第四屏（用户自己的图）──────────────────────────── */

/* 选图区：大标题 + 三张可选示例卡 + 虚线上传行 + 开始分析大按钮。
   按定稿排版，不再做虚线大框 —— 卡片自己会说话 */
.own-pick {
  margin: var(--sp-3) 40rpx 0;
  display: flex;
  flex-direction: column;
}

.own-pick__title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--c-text);
}

/* 三张示例卡：竖版裁切看个大概就够辨认。
   选中 = 标注橙的框 + 右上角实心对勾 —— 和图上标注是同一种颜色语言 */
.own-pick__samples {
  display: flex;
  justify-content: space-between;
  margin-top: var(--sp-4);
}

.own-pick__sample {
  width: 31%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.own-pick__shotbox {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: var(--r-md);
  border: 3rpx solid var(--c-line);
  overflow: hidden;
}

.own-pick__sample--on .own-pick__shotbox {
  border-color: var(--c-mark);
}

.own-pick__shot {
  display: block;
  width: 100%;
  height: 100%;
}

/* 右上角的单选圈：没选是白底描边空心，选中填标注橙 */
.own-pick__radio {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.own-pick__radio--on {
  border-color: var(--c-mark);
  background: var(--c-mark);
}

.own-pick__tick {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

/* 卡片下面的小字标签：选中的跟着变橙、加重 */
.own-pick__label {
  margin-top: var(--sp-2);
  font-size: 28rpx;
  color: var(--c-text-2);
}

.own-pick__label--on {
  color: var(--c-mark);
  font-weight: 700;
}

/* 上传行：虚线框横条，和示例卡分开说话 */
.own-pick__upload {
  margin-top: var(--sp-5);
  padding: var(--sp-4) var(--sp-4);
  border-radius: var(--r-lg);
  border: 2rpx dashed rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.own-pick__upload-text {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--c-text);
}

.own-pick__upload-arrow {
  font-size: 36rpx;
  color: var(--c-text-3);
  line-height: 1;
}

/* 开始分析：全宽标注橙大按钮，本页最重的视觉档 */
.own-pick__go {
  margin-top: 64rpx;
  height: 104rpx;
  border-radius: var(--r-lg);
  background: var(--c-mark);
  display: flex;
  align-items: center;
  justify-content: center;
}

.own-pick__go-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 失败态块：站在引导条的位置。不红色警告、不弹窗 ——
   它要说的是「这次没成，不是你的错，还有两条路」 */
.own-failed {
  margin: var(--sp-3) var(--sp-4) 0;
  padding: var(--sp-3) var(--sp-4);
  border-radius: var(--r-md);
  background: rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--c-line);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.own-failed__title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
}

.own-failed__hint {
  margin-top: var(--sp-1);
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--c-text-3);
  text-align: center;
}

.own-failed__actions {
  display: flex;
  margin-top: var(--sp-3);
}

.own-failed__btn {
  padding: var(--sp-2) var(--sp-5);
  margin: 0 var(--sp-2);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-accent);
}

.own-failed__btn-text {
  font-size: 25rpx;
  color: var(--c-accent);
}

/* 第三屏收尾的入口：评委变成参与者的一步。
   位置在卡片入口下面，措辞是邀请，不是任务 */
.own-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: var(--sp-2);
  border-radius: var(--r-md);
  background: rgba(232, 163, 61, 0.12);
  border: 1rpx solid rgba(232, 163, 61, 0.55);
}

.own-entry__text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-accent);
}
